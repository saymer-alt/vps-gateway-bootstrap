[Unit]
Description=ZAI-84 bounded idempotent Test TUN route restoration
After=test-mihomo.service
Wants=test-mihomo.service

[Service]
Type=oneshot
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/libexec/test-gateway-routes tun
TimeoutStartSec=15

[Install]
WantedBy=multi-user.target
